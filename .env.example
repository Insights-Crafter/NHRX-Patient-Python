# PostgreSQL installed directly on the EC2 host (outside Docker Compose).
# Keep port 5432 closed publicly; allow only the Compose network in pg_hba.conf.
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=replace-with-database-name
PGSSLMODE=require
PGCHANNELBINDING=require

# Set a deployment secret; changing it invalidates existing JWTs.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Private one-time key for setting initial doctor passwords. Do not put it in frontend code.
DOCTOR_PASSWORD_SETUP_KEY=replace-with-a-long-random-setup-secret

# Use the existing AES-SIV key to retain access to previously encrypted values.
# Valid AES-SIV keys are 64, 96, or 128 hexadecimal characters.
AES_SIV_KEY=replace-with-existing-aes-siv-key

# Keep false in production. Set true only for deliberate local table creation.
CREATE_DB_TABLES=false

# Optional comma-separated browser origins for a separately hosted frontend.
# Example: https://portal.example.com
CORS_ORIGINS=

# Cloudflare R2 private bucket. Keep credentials on the backend only.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY=replace-with-r2-access-key
R2_SECRET_KEY=replace-with-r2-secret-key
R2_PATIENT_BUCKET=replace-with-private-bucket-name
